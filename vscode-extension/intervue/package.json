{
  "name": "intervue",
  "displayName": "intervue",
  "description": "Real-time technical interview extension for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],

  "activationEvents": [
  ], 

  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "intervue.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "intervue.interviewerLogin",
        "title": "Intervue : interviewerLogin"
      },
      {
        "command": "intervue.guestLogin",
        "title": "Intervue : guestLogin"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "socket.io-client": "^4.8.3"
  }
}
